<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Studio Landing</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="hero">
        <div class="container">
            <h1>НАШИ САЙТЫ ЗАСТАВЛЯЮТ РАБОТАТЬ ВАШ БИЗНЕС</h1>
            <p class="subtitle">Результат, который приносит прибыль</p>
            
            <div class="stats">
                <div class="stat-item">
                    <span class="number">518</span>
                    <span class="label">завершенных услуг</span>
                </div>
                <div class="stat-item">
                    <span class="number">345</span>
                    <span class="label">клиентов</span>
                </div>
                <div class="stat-item">
                    <span class="number">218</span>
                    <span class="label">постоянных клиентов</span>
                </div>
            </div>
        </div>
    </header>

    <nav class="main-nav">
        <div class="container">
            <ul>
                <li><a href="#">Главная</a></li>
                <li><a href="#">О нас</a></li>
                <li><a href="#">Услуги</a></li>
                <li><a href="#">Наши работы</a></li>
                <li><a href="#">Контакты</a></li>
            </ul>
        </div>
    </nav>

    <section class="services">
        <div class="container">
            <h2 class="section-title">Разработка</h2>
            <div class="services-grid">
                <div class="service-card">
                    <h3>LANDING PAGE</h3>
                    <p class="price">от 25 000 руб</p>
                </div>
                <div class="service-card">
                    <h3>ВЕБ-САЙТ</h3>
                    <p class="price">от 50 000 руб</p>
                </div>
                <div class="service-card">
                    <h3>ИНТЕРНЕТ МАГАЗИН</h3>
                    <p class="price">от 120 000 руб</p>
                </div>
            </div>
        </div>
    </section>

</body>
</html>
