<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Практическая работа 21 - Вариант 6</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" href="#">Portfolio V6</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Главная</a></li>
                    <li class="nav-item"><a class="nav-link" href="#services">Услуги</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">О нас</a></li>
                    <li class="nav-item">
                        <button class="btn btn-outline-light ms-lg-3" data-bs-toggle="modal" data-bs-target="#contactModal">Связаться</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <header id="home" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active" style="background-image: url('https://via.placeholder.com/1920x600/222/fff?text=Slide+1'); height: 500px; background-size: cover;">
                <div class="carousel-caption d-none d-md-block">
                    <h1>Ваш заголовок из PSD</h1>
                    <p>Описание первого слайда.</p>
                </div>
            </div>
            <div class="carousel-item" style="background-image: url('https://via.placeholder.com/1920x600/444/fff?text=Slide+2'); height: 500px; background-size: cover;">
                <div class="carousel-caption d-none d-md-block">
                    <h1>Креативные решения</h1>
                    <p>Описание второго слайда.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#home" data-bs-target="#home" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#home" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </header>

    <main class="container my-5" id="services">
        <h2 class="text-center mb-4">Наши Услуги</h2>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-12 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-laptop fs-1"></i>
                        <h5 class="card-title mt-3">Дизайн</h5>
                        <p class="card-text">Описание услуги на основе вашего макета.</p>
                        <button class="btn btn-primary" data-bs-toggle="tooltip" title="Узнать больше">Подробнее</button>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-12 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Разработка</h5>
                        <p class="card-text">Создание современных веб-интерфейсов.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-12 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">SEO</h5>
                        <p class="card-text">Продвижение вашего бизнеса в сети.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-12 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Маркетинг</h5>
                        <p class="card-text">Анализ и стратегия развития.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <section class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-4">Часто задаваемые вопросы</h2>
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            Вопрос №1
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">Текст ответа из вашего макета.</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="modal fade" id="contactModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Обратная связь</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="contactForm">
                        <div class="mb-3">
                            <label class="form-label">Ваше имя</label>
                            <input type="text" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-dark w-100">Отправить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="script.js"></script>
</body>
</html>
